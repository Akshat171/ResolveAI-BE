# Database
DATABASE_URL=postgresql+asyncpg://resolvai:password@localhost:5432/resolvai
DATABASE_URL_SYNC=postgresql://resolvai:password@localhost:5432/resolvai
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# CORS
CORS_ORIGINS=["http://localhost:3000"]
API_BASE_URL=http://localhost:8000
WIDGET_BASE_URL=http://localhost:5173

# Notion (optional)
NOTION_INTEGRATION_TOKEN=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
